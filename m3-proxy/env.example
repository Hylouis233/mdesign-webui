# m3-proxy 环境变量模板。真实值含密钥，勿入库。
# 调用方（webui 等）访问本代理用的 Bearer 令牌，随机长串：
PROXY_TOKEN=<RANDOM_LONG_SECRET>
# 监听（默认回环；对外暴露需自行加防护）：
PROXY_PORT=8319
PROXY_BIND=127.0.0.1
# 账号 token 文件（Python 版；格式见 m3-proxy/README.md）：
M3_TOKEN_FILE=/opt/m4e/m3-proxy/m3_token.json
# 上游（默认官方 mavis 端点，一般不用改）：
#MAVIS_BASE=https://agent.minimaxi.com/mavis/api/v1/llm/v1
