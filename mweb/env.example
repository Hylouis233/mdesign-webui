# mdesign-webui 环境变量模板（systemd EnvironmentFile 用）。
# 复制为 mweb/env 并填入真实值；真实 env 含密钥，已 gitignore，严禁入库/外传。
MWEB_PORT=80
MWEB_BIND=0.0.0.0
MWEB_RENDERER_DIR=/opt/m4e/webui/renderer
MWEB_GATEWAY=http://127.0.0.1:8001
MWEB_COMFY_URL=http://127.0.0.1:8188
MWEB_COMFY_TOKEN=<COMFYUI_BEARER_JWT>
MWEB_M3_URL=http://127.0.0.1:8319
MWEB_M3_TOKEN=<M3_PROXY_TOKEN>
MWEB_TOKEN_FILE=<m3_token.json 路径>
MWEB_TOKEN_RENEWED_FILE=<m3_token_renewed.json 路径>
MWEB_COMFY_FORWARD=0.0.0.0:18188
MWEB_REWRITE_BACKEND=http://<服务器地址>:18188
MWEB_SEED_INTERVAL_SEC=600
